# Optional overrides. By default, the scripts use the current user's standard
# Hugging Face cache and a repository-local models directory.
# HF_HOME=/path/to/huggingface-cache
# MODEL_PATH=/path/to/DeepSeek-V4-Flash-0731

# OpenAI-compatible API listener. Use 127.0.0.1 unless remote access is intended.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Official 0731 release. It includes a DSpark draft module.
MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731

# Required only when running the destructive setup-nvme.sh provisioning script.
# Obtain these with: lsblk -d -o NAME,MODEL,SERIAL,SIZE
DEEPSEEK_NVME1_SERIAL=
DEEPSEEK_NVME2_SERIAL=

# Machine-local mount locations. Change these to match your host.
DEEPSEEK_NVME1_MOUNT=/mnt/deepseek-nvme1
DEEPSEEK_NVME2_MOUNT=/mnt/deepseek-nvme2
MOET_PLANES_CACHE="${DEEPSEEK_NVME1_MOUNT}/moet-planes-0731"
# Persistent disk-backed FP4 expert store. Expect roughly 130 GiB for TP=2.
MOET_STORE_DIR="${DEEPSEEK_NVME2_MOUNT}/moet-store-0731"
SERVED_MODEL_NAME=deepseek-v4-flash

# Conservative settings from the model's verified TP=2 runtime configuration.
MAX_MODEL_LEN=250000
MAX_NUM_SEQS=8
# Bootstrap with a minimal mHC warmup surface. Increase after the first healthy launch.
MAX_NUM_BATCHED_TOKENS=16
GPU_MEMORY_UTILIZATION=0.83
