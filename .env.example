# Optional overrides. By default, the scripts use the current user's standard
# Hugging Face cache and a repository-local models directory.
# HF_HOME=/path/to/huggingface-cache
# MODEL_PATH=/path/to/DeepSeek-V4-Flash-0731

# OpenAI-compatible API listener. Use 127.0.0.1 unless remote access is intended.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Official 0731 release. It includes a DSpark draft module.
MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731

# Required only when running the destructive setup-nvme.sh provisioning script.
# Obtain these with: lsblk -d -o NAME,MODEL,SERIAL,SIZE
DEEPSEEK_NVME1_SERIAL=
DEEPSEEK_NVME2_SERIAL=

# Machine-local mount locations. Change these to match your host.
DEEPSEEK_NVME1_MOUNT=/mnt/deepseek-nvme1
DEEPSEEK_NVME2_MOUNT=/mnt/deepseek-nvme2
MOET_PLANES_CACHE="${DEEPSEEK_NVME1_MOUNT}/moet-planes-0731"
# Persistent vLLM/FlashInfer kernel and autotuning cache. The launcher falls
# back to the ignored repository-local cache/vllm directory when unset.
# VLLM_CACHE_DIR=/path/to/vllm-cache
# Persistent disk-backed FP4 expert store. Expect roughly 130 GiB for TP=2.
MOET_STORE_DIR="${DEEPSEEK_NVME2_MOUNT}/moet-store-0731"
# Optional after the first completed build. Set this, run
# ./scripts/split-moet-store-tp2.sh, then restart to read one rank per SSD.
MOET_STORE_RANK0_DIR=
SERVED_MODEL_NAME=deepseek-v4-flash

# Verified 400K TP=2 serving envelope. The context limit includes prompt and
# generated tokens. Clients should cap max_completion_tokens at 128000.
MAX_MODEL_LEN=400000
MAX_NUM_SEQS=2
# Measured 300 W C=2 throughput winner on the documented TP=2 host.
MAX_NUM_BATCHED_TOKENS=4096
FP4_RECOVERY_POOL_GB=24
# DSpark draft length. Benchmark 3, 5, and 7 on the target hardware before
# changing this from the verified default of 7.
DSPARK_NUM_SPECULATIVE_TOKENS=7
GPU_MEMORY_UTILIZATION=0.92

# Set to 1 only when investigating recovery-pool coverage; it is verbose.
VLLM_MOE_W2_DELTA_TRACE=0
VLLM_MOE_W2_DELTA_TRACE_EVERY=64

# PCIe GPU peer transport. This host requires IOMMU disabled in firmware;
# restore NCCL_P2P_DISABLE=1 if NCCL hangs during distributed initialization.
NCCL_P2P_DISABLE=0
NCCL_P2P_LEVEL=PHB
